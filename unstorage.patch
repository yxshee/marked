From 4002a320a601be314b31a52d1f7771a5583a0d83 Mon Sep 17 00:00:00 2001
From: yxshee <84263676+yxshee@users.noreply.github.com>
Date: Mon, 2 Nov 2026 12:16:31 +0000
Subject: [PATCH] fix: count getKeys maxDepth from the storage root for mounted
 native drivers

---
 src/storage.ts       | 13 ++++++++++++-
 test/storage.test.ts | 23 +++++++++++++++++++++++
 2 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/src/storage.ts b/src/storage.ts
index a90cbbc..e96d880 100644
--- a/src/storage.ts
+++ b/src/storage.ts
@@ -478,7 +478,18 @@ export function createStorage<T extends StorageValue>(
         if (!mount.driver.flags?.maxDepth) {
           allMountsSupportMaxDepth = false;
         }
-        const rawKeys = await asyncCall(mount.driver.getKeys, mount.relativeBase, opts);
+        // maxDepth counts from the storage root, but a driver that supports it natively counts
+        // from its own root, so take the depth of the mount point off before passing it down
+        const mountDepth = mount.mountpoint.split(":").length - 1;
+        const driverMaxDepth = opts.maxDepth === undefined ? undefined : opts.maxDepth - mountDepth;
+        const rawKeys =
+          driverMaxDepth !== undefined && driverMaxDepth < 0
+            ? []
+            : await asyncCall(
+                mount.driver.getKeys,
+                mount.relativeBase,
+                driverMaxDepth === opts.maxDepth ? opts : { ...opts, maxDepth: driverMaxDepth },
+              );
         for (const key of rawKeys) {
           const fullKey = mount.mountpoint + normalizeKey(key);
           if (!maskedMounts.some((p) => fullKey.startsWith(p))) {
diff --git a/test/storage.test.ts b/test/storage.test.ts
index d528123..b99cadc 100644
--- a/test/storage.test.ts
+++ b/test/storage.test.ts
@@ -259,6 +259,29 @@ describe("Regression", () => {
     }
   });
 
+  it("getKeys counts maxDepth from the storage root when every mount supports it natively", async () => {
+    const storage = createStorage({ driver: fs({ base: resolve(__dirname, "tmp/fs-root") }) });
+    storage.mount("/storage_b", fs({ base: resolve(__dirname, "tmp/fs-mount") }));
+
+    try {
+      await storage.setItem("/file_depth0", "contents");
+      await storage.setItem("/storage_b/file_depth1", "contents");
+      await storage.setItem("/storage_b/depth1/file_depth2", "contents");
+
+      expect(await storage.getKeys(undefined, { maxDepth: 0 })).toMatchObject(["file_depth0"]);
+      expect((await storage.getKeys(undefined, { maxDepth: 1 })).sort()).toMatchObject([
+        "file_depth0",
+        "storage_b:file_depth1",
+      ]);
+      expect((await storage.getKeys("storage_b", { maxDepth: 2 })).sort()).toMatchObject([
+        "storage_b:depth1:file_depth2",
+        "storage_b:file_depth1",
+      ]);
+    } finally {
+      await storage.clear();
+    }
+  });
+
   it("prefixStorage getItems to not returns null (issue #396)", async () => {
     const storage = createStorage();
     await storage.setItem("namespace:key", "value");
-- 
2.43.0

