From 495edd14609017fe1384f3273938cca94a744212 Mon Sep 17 00:00:00 2001
From: yxshee <84263676+yxshee@users.noreply.github.com>
Date: Mon, 2 Nov 2026 11:47:56 +0000
Subject: [PATCH] fix: end a list item before a lazy line after a nested block

A line with less indentation than a list item is only a lazy
continuation when it continues a paragraph. The list tokenizer checked
the previous line for a fence, heading or hr, but it used the regexes
scaled to the item indent on a line that is already relative to the
item content, and it did not look inside a nested list item or
blockquote on that line. So text after `- - # heading`, `- > ***`, or a
fenced code block in a nested item was pulled into the outer item.
---
 src/Tokenizer.ts                              | 14 ++++++
 src/rules.ts                                  |  2 +
 .../new/list_lazy_after_nested_block.html     | 45 +++++++++++++++++++
 .../specs/new/list_lazy_after_nested_block.md | 20 +++++++++
 4 files changed, 81 insertions(+)
 create mode 100644 test/specs/new/list_lazy_after_nested_block.html
 create mode 100644 test/specs/new/list_lazy_after_nested_block.md

diff --git a/src/Tokenizer.ts b/src/Tokenizer.ts
index 26fcb34..449bc93 100644
--- a/src/Tokenizer.ts
+++ b/src/Tokenizer.ts
@@ -394,6 +394,9 @@ export class _Tokenizer<ParserOutput = string, RendererOutput = string> {
           const htmlBeginRegex = this.rules.other.htmlBeginRegex(indent);
           const blockquoteBeginRegex = this.rules.other.blockquoteBeginRegex(indent);
 
+          // A lazy line continues a paragraph, so it is not checked for the start of a block
+          let lineIsLazy = false;
+
           // Check if following lines should be included in List Item
           while (src) {
             const rawLine = src.split('\n', 1)[0];
@@ -440,6 +443,7 @@ export class _Tokenizer<ParserOutput = string, RendererOutput = string> {
 
             if (nextLineWithoutTabs.search(this.rules.other.nonSpaceChar) >= indent || !nextLine.trim()) { // Dedent if possible
               itemContents += '\n' + nextLineWithoutTabs.slice(indent);
+              lineIsLazy = false;
             } else {
               // not enough indentation
               if (blankLine) {
@@ -459,6 +463,15 @@ export class _Tokenizer<ParserOutput = string, RendererOutput = string> {
               if (hrRegex.test(line)) {
                 break;
               }
+              if (!this.options.pedantic && !lineIsLazy) {
+                // `line` is relative to the item content, so a block on it can be indented up to 3 spaces whatever
+                // the item indent is. A nested list item or blockquote on it, as in `- # heading` or `> ---`, holds
+                // a block that a lazy line cannot continue either, so check what follows those markers too.
+                const lastBlockLine = line.replace(this.rules.other.nestedContainerMarkers, '');
+                if (this.rules.block.fences.test(lastBlockLine) || this.rules.block.heading.test(lastBlockLine) || this.rules.block.hr.test(lastBlockLine)) {
+                  break;
+                }
+              }
 
               // A lazy continuation can look like a setext underline after
               // list indentation is removed. Keep it in the paragraph.
@@ -469,6 +482,7 @@ export class _Tokenizer<ParserOutput = string, RendererOutput = string> {
                 ? `    ${nextLineWithoutTabs.replace(/^ {0,3}/, '')}`
                 : nextLine;
               itemContents += '\n' + continuation;
+              lineIsLazy = true;
             }
 
             blankLine = !nextLine.trim();
diff --git a/src/rules.ts b/src/rules.ts
index d74f2e2..249b366 100644
--- a/src/rules.ts
+++ b/src/rules.ts
@@ -107,6 +107,8 @@ export const other = {
   // html start conditions in the paragraph rule below; type 7 is excluded there
   htmlBeginRegex: cachedIndentRegex((indent: number) => new RegExp(`^ {0,${indent}}(?:</?(?:${_tag})(?: +|$|/?>)|<(?:(?:script|pre|style|textarea)(?:[\\s>]|$)|!--)|<\\?|<![A-Za-z]|<!\\[CDATA\\[)`, 'i')),
   blockquoteBeginRegex: cachedIndentRegex((indent: number) => new RegExp(`^ {0,${indent}}>`)),
+  // list item and blockquote markers that open nested blocks at the start of a line, as in `- > # heading`
+  nestedContainerMarkers: /^(?: {0,3}(?:(?:[*+-]|\d{1,9}[.)])[ \t]+|>[ \t]?))+/,
 };
 
 /**
